# Copy this file to .env and you're done — every value below already works
# against a local Postgres/Redis set up by scripts/setup.sh (the passwords
# match app/db/seed/bootstrap_roles.sql's own dev-only literals exactly).
# Nothing here needs editing to run this project locally.
#
#     cp .env.example .env

# ── Application ─────────────────────────────────────────────
ENVIRONMENT=development              # development | staging | production
DEBUG=true
APP_NAME="EMS"
API_V1_PREFIX=/api/v1

# ── Database ────────────────────────────────────────────────
# Runtime role: NOT the table owner, NOT superuser, NOBYPASSRLS (Section 8.2)
DATABASE_URL=postgresql+psycopg2://ems_app:ems_app_dev_only@localhost:5432/ems_pro
# Migration role: owns the schema, used only by Alembic and scripts/setup.sh
ALEMBIC_DATABASE_URL=postgresql+psycopg2://ems_owner:ems_owner_dev_only@localhost:5432/ems_pro
# Tests connect as the APPLICATION role, so RLS and grants are actually exercised (15.2)
TEST_DATABASE_URL=postgresql+psycopg2://ems_app:ems_app_dev_only@localhost:5432/ems_pro_test
TEST_MIGRATION_URL=postgresql+psycopg2://ems_owner:ems_owner_dev_only@localhost:5432/ems_pro_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ── Security ────────────────────────────────────────────────
# A fixed, clearly-labeled dev-only value — never use this in staging or
# production. Generate a real one there:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=local_dev_only_not_for_production_5f8a2c9143e6
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Only needed once WP-08 (KYC encryption) lands — unset is fine until then.
# Generate: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Employee invite/activation token lifetime (Spec 7.3).
INVITE_TOKEN_EXPIRE_DAYS=7
# Password-reset OTP: TTL and attempt cap (Spec 7.9).
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Password policy floor (Spec 9.1) — enforced server-side regardless of what
# the frontend's own Zod schema already checks.
PASSWORD_MIN_LENGTH=10

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173"]'

# ── Email ───────────────────────────────────────────────────
EMAIL_BACKEND=console                # console | sendgrid — console just prints to stdout, this project's only tested path
SENDGRID_API_KEY=
EMAIL_FROM=noreply@example.com
FRONTEND_BASE_URL=http://localhost:5173

# ── File storage ────────────────────────────────────────────
STORAGE_BACKEND=local                # local | s3
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10

# ── Observability ───────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── Background jobs (Spec 13) ────────────────────────────────
# Where a Celery export task (attendance CSV, audit log CSV) writes its
# output file in STORAGE_BACKEND=local mode. Created automatically.
EXPORT_DIR=var/exports

# ── Dashboard cache (Spec 11.10) ─────────────────────────────
DASHBOARD_CACHE_TTL_SECONDS=60

# ── Platform defaults for NEW companies ─────────────────────
# These seed a company's `company_settings` row at approval time and are never
# read again afterwards. Per-tenant policy lives in the `company_settings` table
# (7.2), not here.
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
DEFAULT_WORKING_WEEK_DAYS=5
DEFAULT_HALF_DAY_HOURS_THRESHOLD=4

# ── scripts/setup.sh only — never read by the app itself ─────
# The role scripts/setup.sh uses ONLY to create the database (if missing)
# and run bootstrap_roles.sql the first time. Must be a real Postgres
# superuser. Defaults to your OS username, matching Homebrew/Postgres.app's
# own default local superuser — uncomment and change only if that's wrong
# for your machine (e.g. a different admin role, or one that needs a
# password).
# PG_BOOTSTRAP_USER=
# PG_BOOTSTRAP_PASSWORD=
